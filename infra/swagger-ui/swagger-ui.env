# swaggerapi/swagger-ui:v5.29.0 — aggregated docs behind Traefik at /docs (HU-104, T014).
# PHASE 1: only the monolith exposes OpenAPI. Each URL is routed by Traefik
# (router docs-<service>) to <service>/v3/api-docs with the /docs/<service> prefix stripped,
# protected by basicAuth. A service that is down only breaks its own entry.
# After the cutover use swagger-ui.cutover.env instead.
# No secrets here.
BASE_URL=/docs
URLS=[{"url":"/docs/backend/v3/api-docs","name":"backend (monolith)"}]
URLS_PRIMARY_NAME=backend (monolith)
DEEP_LINKING=true
DISPLAY_REQUEST_DURATION=true
TRY_IT_OUT_ENABLED=false
WITH_CREDENTIALS=true
