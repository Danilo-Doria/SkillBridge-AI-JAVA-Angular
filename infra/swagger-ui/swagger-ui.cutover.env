# swagger-ui configuration once ai-service and payment-service are live
# (infra/traefik/dynamic-cutover/routers.cutover.yml active). Same rules as swagger-ui.env.
# audit-backend has no springdoc today; add {"url":"/docs/audit-backend/v3/api-docs",...}
# plus a docs-audit-backend router only after it exposes /v3/api-docs.
BASE_URL=/docs
URLS=[{"url":"/docs/backend/v3/api-docs","name":"backend (monolith)"},{"url":"/docs/ai-service/v3/api-docs","name":"ai-service"},{"url":"/docs/payment-service/v3/api-docs","name":"payment-service"}]
URLS_PRIMARY_NAME=backend (monolith)
DEEP_LINKING=true
DISPLAY_REQUEST_DURATION=true
TRY_IT_OUT_ENABLED=false
WITH_CREDENTIALS=true
