DB_HOST=postgres
DB_PORT=5432
DB_NAME=skillbridge
DB_USER=skillbridge_user
DB_PASSWORD=skillbridge_password

JWT_SECRET=super_secret_key_change_me_in_production_1234567890
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088,http://localhost:8090

AI_PROVIDER=mock
AI_AUDIO_PROVIDER=elevenlabs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_BOOKING_EVENTS=booking-events
KAFKA_CONSUMER_GROUP=skillbridge-main-group

# HU-23 multimedia upload limits (bytes)
AI_MEDIA_MAX_AUDIO_BYTES=10485760
AI_MEDIA_MAX_IMAGE_BYTES=5242880
AI_MULTIPART_MAX_FILE_SIZE=10MB
AI_MULTIPART_MAX_REQUEST_SIZE=10MB

# Notifications
NOTIFICATIONS_SENDER=simulated
NOTIFICATIONS_EMAIL_FROM=no-reply@skillbridge.local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Text-to-Speech (ElevenLabs)
TTS_ENABLED=false #true para probar
TTS_MAX_CHARS=1000
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
