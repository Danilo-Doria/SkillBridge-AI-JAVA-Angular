# ==============================================================================
# SkillBridge AI - Entorno de Configuración Local y de Referencia
# ==============================================================================
# Copia este archivo como .env (cp .env.example .env) y ajusta los valores necesarios.
# El .env está en .gitignore: NUNCA versiones claves reales. Los valores your_..._here son marcadores.

# ------------------------------------------------------------------------------
# 1. Base de Datos Relacional (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev
DATABASE_URL=jdbc:postgresql://postgres:5432/skillbridge
DATABASE_USER=skillbridge
DATABASE_PASSWORD=skillbridge_dev
DB_POOL_SIZE=5

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación (JWT & CORS)
# ------------------------------------------------------------------------------
# JWT firmado con RS256. Genera un par (PKCS#8 privada / X.509 pública):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# En variables de entorno el PEM puede ir en una línea con \n literales. NUNCA versionar claves reales.
# La privada solo la usa el backend; los servicios satélite reciben solo la pública.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=skillbridge-1
# Solo migración desde HS256 (valida, no emite). Vaciar cuando expiren los tokens antiguos.
JWT_LEGACY_SECRET=
# Solo desarrollo local: claves efímeras en memoria (los tokens mueren al reiniciar). En producción: false y JWT_PRIVATE_KEY/JWT_PUBLIC_KEY reales.
JWT_GENERATE_EPHEMERAL_KEYS=true
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088,http://localhost:8090

# ------------------------------------------------------------------------------
# 3. Caché y Mensajería (Redis & RabbitMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
OFFERINGS_CACHE_TTL_MINUTES=10
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ------------------------------------------------------------------------------
# 4. Event Streaming (Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_BOOKING_EVENTS=booking-events
KAFKA_TOPIC_RECOMMENDATION_EVENTS=recommendation-events
KAFKA_CONSUMER_GROUP=skillbridge-main-group

# ------------------------------------------------------------------------------
# 5. Microservicio de Auditoría (MongoDB)
# ------------------------------------------------------------------------------
AUDIT_MONGO_DB=audit
AUDIT_MONGO_URI=mongodb://audit-mongo:27017/audit

# ------------------------------------------------------------------------------
# 6. Inteligencia Artificial (Gemini, OpenAI, Groq)
# ------------------------------------------------------------------------------
# Proveedor principal para recomendaciones: gemini | openai | mock
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=60

# Google Gemini (LLM. gemini-3.1-flash-lite verificado con respuesta en ~1.4 s; gemini-3.8-flash no respondió en 40 s con la clave de pruebas: recomendaciones, voz e imagen y respuestas del asistente de conocimiento)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
# Embeddings del asistente de conocimiento (HU-26). Clave PROPIA: no reutilices GEMINI_API_KEY.
# Sin ella, el asistente responde 503 (nunca respuestas simuladas).
GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key_here

# OpenAI (Opcional si AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Groq (Speech-to-Text de baja latencia con Whisper)
GROQ_API_KEY=your_groq_api_key_here
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# Proveedor de audio: gemini | groq
AI_AUDIO_PROVIDER=gemini

# Límites de carga de archivos multimedia para IA (bytes)
AI_MEDIA_MAX_AUDIO_BYTES=10485760
AI_MEDIA_MAX_IMAGE_BYTES=5242880
AI_MULTIPART_MAX_FILE_SIZE=10MB
AI_MULTIPART_MAX_REQUEST_SIZE=10MB

# ------------------------------------------------------------------------------
# 7. Asistente de Conocimiento RAG (HU-26)
# ------------------------------------------------------------------------------
# Requiere PostgreSQL con pgvector (imagen pgvector/pgvector:pg17) y GEMINI_EMBEDDING_API_KEY.
# Fragmentos recuperados por consulta
RAG_TOP_K=3
# Similitud coseno mínima para llamar al LLM. 0.5 es PROVISIONAL: se calibra con la evaluación real (T030).
RAG_MIN_SCORE_THRESHOLD=0.5
RAG_TIMEOUT_SECONDS=10
RAG_MAX_CONTEXT_CHARS=6000
# Constante k de Reciprocal Rank Fusion (BM25 + embeddings)
RAG_RRF_K=60
# Recomendaciones: con más ofertas activas que este número, solo las N más cercanas a la necesidad llegan al LLM (0 = enviar todo)
RAG_RECOMMENDATION_SHORTLIST_SIZE=15

# ------------------------------------------------------------------------------
# 8. Text-to-Speech (ElevenLabs)
# ------------------------------------------------------------------------------
TTS_ENABLED=false
TTS_MAX_CHARS=1000
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ------------------------------------------------------------------------------
# 9. Pasarela de Pagos (Stripe)
# ------------------------------------------------------------------------------
# Proveedor de pago: stripe | simulated
PAYMENT_PROVIDER=stripe
STRIPE_API_URL=https://api.stripe.com
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_CURRENCY=usd

# ------------------------------------------------------------------------------
# 10. Servidor de Correo y Notificaciones (Mailpit / SMTP)
# ------------------------------------------------------------------------------
# Sender: simulated (logs) | email (servidor SMTP real o Mailpit)
NOTIFICATIONS_SENDER=simulated
NOTIFICATIONS_EMAIL_FROM=no-reply@skillbridge.local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ------------------------------------------------------------------------------
# 11. Videollamadas (Zoom) - opcional
# ------------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ------------------------------------------------------------------------------
# 12. Reglas de Negocio
# ------------------------------------------------------------------------------
BOOKING_CANCELLATION_MINIMUM_NOTICE_HOURS=24
