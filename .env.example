# ==============================================================================
# SkillBridge AI - Entorno de Configuración Local y de Referencia
# ==============================================================================
# Copia este archivo como .env (cp .env.example .env) y ajusta los valores necesarios.

# ------------------------------------------------------------------------------
# 1. Base de Datos Relacional (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev
DATABASE_URL=jdbc:postgresql://postgres:5432/skillbridge
DATABASE_USER=skillbridge
DATABASE_PASSWORD=skillbridge_dev
DB_POOL_SIZE=5

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación (JWT & CORS)
# ------------------------------------------------------------------------------
# Genera un secreto seguro de al menos 32 caracteres (ej: openssl rand -base64 48)
JWT_SECRET=super_secret_key_change_me_in_production_1234567890
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8088,http://localhost:8090

# ------------------------------------------------------------------------------
# 3. Caché y Mensajería (Redis & RabbitMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
OFFERINGS_CACHE_TTL_MINUTES=10
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ------------------------------------------------------------------------------
# 4. Event Streaming (Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_BOOKING_EVENTS=booking-events
KAFKA_TOPIC_RECOMMENDATION_EVENTS=recommendation-events
KAFKA_CONSUMER_GROUP=skillbridge-main-group

# ------------------------------------------------------------------------------
# 5. Microservicio de Auditoría (MongoDB)
# ------------------------------------------------------------------------------
AUDIT_MONGO_DB=audit
AUDIT_MONGO_URI=mongodb://audit-mongo:27017/audit

# ------------------------------------------------------------------------------
# 6. Inteligencia Artificial (Gemini, OpenAI, Groq)
# ------------------------------------------------------------------------------
# Proveedor principal para recomendaciones: gemini | openai | mock
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=10

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=2048

# OpenAI (Opcional si AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Groq (Speech-to-Text de baja latencia con Whisper)
GROQ_API_KEY=your_groq_api_key_here
# Proveedor de audio: gemini | groq
AI_AUDIO_PROVIDER=gemini

# Límites de carga de archivos multimedia para IA (bytes)
AI_MEDIA_MAX_AUDIO_BYTES=10485760
AI_MEDIA_MAX_IMAGE_BYTES=5242880
AI_MULTIPART_MAX_FILE_SIZE=10MB
AI_MULTIPART_MAX_REQUEST_SIZE=10MB

# ------------------------------------------------------------------------------
# 7. Text-to-Speech (ElevenLabs)
# ------------------------------------------------------------------------------
TTS_ENABLED=false
TTS_MAX_CHARS=1000
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ------------------------------------------------------------------------------
# 8. Pasarela de Pagos (Stripe)
# ------------------------------------------------------------------------------
# Proveedor de pago: stripe | simulated
PAYMENT_PROVIDER=stripe
STRIPE_API_URL=https://api.stripe.com
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_CURRENCY=usd

# ------------------------------------------------------------------------------
# 9. Servidor de Correo y Notificaciones (Mailpit / SMTP)
# ------------------------------------------------------------------------------
# Sender: simulated (logs) | email (servidor SMTP real o Mailpit)
NOTIFICATIONS_SENDER=simulated
NOTIFICATIONS_EMAIL_FROM=no-reply@skillbridge.local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ------------------------------------------------------------------------------
# 10. Reglas de Negocio
# ------------------------------------------------------------------------------
BOOKING_CANCELLATION_MINIMUM_NOTICE_HOURS=24
