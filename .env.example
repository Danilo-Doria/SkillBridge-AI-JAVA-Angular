POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:4200,http://localhost:8090

# AI Provider Configuration
APP_AI_PROVIDER=gemini
AI_PROVIDER_TIMEOUT_SECONDS=10

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_BOOKING_EVENTS=booking-events
KAFKA_CONSUMER_GROUP=skillbridge-main-group

# Notifications
NOTIFICATIONS_SENDER=simulated
NOTIFICATIONS_EMAIL_FROM=no-reply@skillbridge.local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
